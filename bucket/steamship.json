      },
      "arm64": {
        "url": "https://github.com/Aureliolo/steamship/releases/download/v$version/steamship-$version-aarch64-pc-windows-msvc.zip",
        "hash": {
          "url": "$url.sha256"
        },
        "extract_dir": "steamship-$version-aarch64-pc-windows-msvc"
      }
    }
  }
