      "hash": "0ebb0f3441b093ff530dbc31e7a063493e2d826fe1b76e55853de085d0007bf5",
      "extract_dir": "steamship-0.9.0-x86_64-pc-windows-msvc"
    },
    "arm64": {
      "url": "https://github.com/Aureliolo/steamship/releases/download/v0.9.0/steamship-0.9.0-aarch64-pc-windows-msvc.zip",
      "hash": "ec6a6d12df4568348035c90c66afa009c75190fd2eedd9ce1a82804cb1f4d87f",
