# The release tools the workflows and actions download, each with the SHA-256 of the archive they
# fetch. A step reads one value with `.github/pin.sh <NAME>`. Renovate raises a tag and its digest
# together, and pins.yml corrects the digest where the release ships a bare-hash checksum file.
# Every name is unique, since a raised pin is matched to main's by it.

# renovate: datasource=github-release-attachments depName=goreleaser/nfpm versioning=semver
NFPM_TAG=v2.49.0
NFPM_SHA256=2afaa5ffb5e3493402e31e7c67a5a1fb42133e3f66fc315ca0051934125561c7

